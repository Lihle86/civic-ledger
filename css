.:root {
  --background: #f1f5f9;
  --surface: #ffffff;
  --text: #0f172a;
  --muted-text: #475569;
  --primary: #0284c7;
  --primary-dark: #075985;
  --success: #22c55e;
  --success-dark: #166534;
  --danger: #ef4444;
  --danger-dark: #991b1b;
  --border: #cbd5e1;
}
notification-panel {
  position: sticky;
  top: 10px;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
  padding: 13px;
  color: var(--text);
  background: #075985;
  border: 1px solid var(--primary);
  border-radius: 9px;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.3);
}

.notification-panel.success {
  background: var(--success-dark);
  border-color: var(--success);
}

.notification-panel.warning {
  background: var(--danger-dark);
  border-color: var(--danger);
}

.n.notification-panel {
  position: sticky;
  top: 10px;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  width: 100%;
  box-sizing: border-box;
  margin: 0 0 18px;
  padding: 13px 14px;
  color: #ffffff;
  background: #075985;
  border: 1px solid #0284c7;
  border-radius: 10px;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.25);
  font-size: 0.95rem;
  line-height: 1.45;
}

.notification-panel.success {
  color: #ffffff;
  background: #166534;
  border-color: #22c55e;
}

.notification-panel.warning {
  color: #ffffff;
  background: #991b1b;
  border-color: #ef4444;
}

.notification-panel button {
  flex: 0 0 auto;
  width: 34px;
  min-width: 34px;
  min-height: 34px;
  margin: -3px -3px 0 auto;
  padding: 0;
  color: #ffffff;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 1.45rem;
  line-height: 1;
  cursor: pointer;
}

.notification-panel button:hover,
.notification-panel button:focus-visible {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.7);
  outline: none;
}

.help-text {
  margin: 0.35rem 0 1rem;
  color: #475569;
  font-size: 0.9rem;
  line-height: 1.55;
}

.hidden {
  display: none !important;
}
