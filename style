:root {
  --background: #e2e8f0;
  --surface: #ffffff;
  --text: #0f172a;
  --muted-text: #475569;
  --primary: #0284c7;
  --primary-dark: #075985;
  --success: #22c55e;
  --success-dark: #166534;
  --danger: #ef4444;
  --danger-dark: #991b1b;
  --border: #cbd5e1;
  --shadow: 0 12px 28px rgba(15, 23, 42, 0.12);
}

* {
  box-sizing: border-box;
}

html {
  background: var(--background);
}

body {
  margin: 0;
  color: var(--text);
  background: var(--background);
  font-family: Arial, Helvetica, sans-serif;
  line-height: 1.5;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  width: 100%;
  min-height: 46px;
  margin-top: 10px;
  padding: 11px 14px;
  color: #ffffff;
  background: var(--primary);
  border: 1px solid var(--primary);
  border-radius: 9px;
  font-weight: 700;
  cursor: pointer;
}

button:hover,
button:focus-visible {
  background: var(--primary-dark);
  border-color: var(--primary-dark);
  outline: 3px solid rgba(2, 132, 199, 0.28);
  outline-offset: 2px;
}

.secondary-button {
  color: var(--primary-dark);
  background: #ffffff;
  border-color: var(--primary);
}

.secondary-button:hover,
.secondary-button:focus-visible {
  color: #ffffff;
  background: var(--primary-dark);
}

.app-shell {
  width: min(100%, 760px);
  margin: 0 auto;
  padding: 16px;
}

.app-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 6px 0 18px;
  color: #ffffff;
}

.app-header h1 {
  margin: 0;
  font-size: 1.65rem;
}

.app-header p {
  margin: 2px 0 0;
  color: #dbeafe;
}

.logo {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  color: #ffffff;
  background: #0f172a;
  border: 2px solid #38bdf8;
  border-radius: 14px;
  font-size: 1.15rem;
  font-weight: 800;
}

.card {
  margin-bottom: 16px;
  padding: 18px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: var(--shadow);
}

.card h2 {
  margin: 0 0 12px;
  color: #0f172a;
  font-size: 1.2rem;
}

.introduction p {
  margin-top: 0;
}

label {
  display: block;
  margin: 14px 0 6px;
  color: var(--text);
  font-weight: 700;
}

input,
select,
textarea {
  width: 100%;
  padding: 11px 12px;
  color: var(--text);
  background: #ffffff;
  border: 1px solid var(--border);
  border-radius: 8px;
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--primary);
  outline: 3px solid rgba(2, 132, 199, 0.2);
}

textarea {
  resize: vertical;
}

.checkbox-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 14px;
  font-weight: 400;
}

.checkbox-row input {
  width: 20px;
  min-width: 20px;
  height: 20px;
  margin-top: 2px;
}

.warning {
  margin-top: 14px;
  padding: 12px;
  color: #7f1d1d;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 9px;
}

.help-text {
  margin: 0.35rem 0 1rem;
  color: var(--muted-text);
  font-size: 0.9rem;
  line-height: 1.55;
}

.notification-panel {
  position: sticky;
  top: 10px;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  width: 100%;
  margin: 0 0 18px;
  padding: 13px 14px;
  color: #ffffff;
  background: #075985;
  border: 1px solid #0284c7;
  border-radius: 10px;
  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.25);
  font-size: 0.95rem;
  line-height: 1.45;
}

.notification-panel.success {
  color: #ffffff;
  background: var(--success-dark);
  border-color: var(--success);
}

.notification-panel.warning {
  color: #ffffff;
  background: var(--danger-dark);
  border-color: var(--danger);
}

.notification-panel button {
  flex: 0 0 auto;
  width: 34px;
  min-width: 34px;
  min-height: 34px;
  margin: -3px -3px 0 auto;
  padding: 0;
  color: #ffffff;
  background: transparent;
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 1.45rem;
  line-height: 1;
}

.notification-panel button:hover,
.notification-panel button:focus-visible {
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.7);
  outline: none;
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.status {
  padding: 6px 9px;
  color: #075985;
  background: #e0f2fe;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
}

.result-label {
  margin-bottom: 3px;
  color: var(--muted-text);
}

.main-amount {
  margin: 0 0 12px;
  color: #b91c1c;
  font-size: 2rem;
  font-weight: 800;
}

.result-message {
  margin-bottom: 14px;
}

.calculation {
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.calculation-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 11px 12px;
  border-bottom: 1px solid var(--border);
}

.calculation-row:last-child {
  border-bottom: 0;
}

.total-row {
  color: #0c4a6e;
  background: #e0f2fe;
  font-weight: 800;
}

.success-message {
  margin-top: 14px;
  padding: 13px;
  color: #166534;
  background: #f0fdf4;
  border: 1px solid #86efac;
  border-radius: 9px;
}

.case-number {
  margin-bottom: 10px;
  color: #0c4a6e;
  font-size: 1.05rem;
  font-weight: 800;
}

.access-code {
  display: inline-block;
  padding: 4px 7px;
  color: #0f172a;
  background: #e2e8f0;
  border-radius: 6px;
  font-family: monospace;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.print-row {
  display: grid;
  grid-template-columns: minmax(130px, 40%) 1fr;
  gap: 12px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border);
}

.print-label {
  color: var(--muted-text);
  font-weight: 700;
}

.privacy-text {
  color: var(--muted-text);
}

.app-footer {
  padding: 8px 10px 20px;
  color: #334155;
  text-align: center;
  font-size: 0.82rem;
}

.app-footer p {
  margin: 5px 0;
}

.hidden {
  display: none !important;
}

@media print {
  body {
    background: #ffffff;
  }

  .app-header,
  .introduction,
  .notification-panel,
  #resultCard,
  #savedMessage,
  #siteReportResult,
  #printCaseButton,
  button,
  .app-footer {
    display: none !important;
  }

  .app-shell {
    width: 100%;
    padding: 0;
  }

  .card {
    box-shadow: none;
    border: 0;
  }

  #casePack {
    display: block !important;
  }
}
